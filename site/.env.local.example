# KAP Radar sitesi — ortam değişkenleri
# Kopyala:  cp .env.local.example .env.local
#
# DİKKAT: buraya yalnızca YAYINLANABİLİR anahtar girer.
# `service_role` / `SUPABASE_SECRET_KEY` siteye ASLA konmaz — depo
# kökündeki .env.example'da da yazdığı gibi o yalnız worker'ındır.
# Site tek bir genel yüzeyden okur: `public.akis` view'ı. Taban
# tablolarda RLS açık ve politika yok, yani bu anahtar sızsa bile
# yayına hazır bildirimlerden fazlası görünmez.

NEXT_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co

# Klasik anon JWT kullanılıyor. Yeni format sb_publishable_* anahtarları
# bu projede 401 veriyor (bkz. depo README).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
