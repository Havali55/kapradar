# KAP Radar — ortam degiskenleri sablonu
# Bu dosya repoya girer. Gercek degerler .env dosyasina yazilir (.gitignore'da).
# Kopyala:  cp .env.example .env

# --- Supabase / Postgres ---
# Baglanti secimi onemli (bkz. README):
#   6543 transaction pooler -> prepared statement kisiti, uzun omurlu worker'a uygun degil
#   5432 session pooler     -> KULLANILAN. IPv4, migration ve worker icin dogru secim
#   db.<ref>.supabase.co    -> IPv6-only, Railway IPv4 egress ile calismaz
DATABASE_URL=postgresql://postgres.<proje-ref>:<PAROLA>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://<proje-ref>.supabase.co
# Yayinlanabilir anahtar: tarayiciya gidebilir, RLS'e tabidir.
SUPABASE_PUBLISHABLE_KEY=
# Gizli anahtar: RLS'i bypass eder. YALNIZCA worker'da. Siteye ASLA konmaz.
SUPABASE_SECRET_KEY=

# --- KAP cekici ---
# Ucu de zorunlu, yoksa WAF baglantiyi dusurur (bkz. spec Adim 0):
# oturum isitmasi (GET /tr/bildirim-sorgu) + Referer + durust User-Agent
KAP_USER_AGENT=kap-radar/0.1 (+iletisim: ornek@ornek.com)
KAP_ISTEK_ARALIGI_MS=500
KAP_MAKS_YENIDEN_DENEME=5

# --- Gemini (ilk kez Adim 12'de kullanilir) ---
GEMINI_API_KEY=
GEMINI_KATMAN1_MODEL=gemini-3.1-flash-lite
GEMINI_KATMAN2_MODEL=gemini-3.8-flash

# --- X / Twitter botu (Adim 11+) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
