# KAP Radar — ortam degiskenleri sablonu
# Bu dosya repoya girer. Gercek degerler .env dosyasina yazilir (.gitignore'da).
# Kopyala:  cp .env.example .env

# --- Supabase / Postgres ---
# Supabase panel > Settings > Database > Connection string
# Worker yazar: pooler yerine dogrudan baglanti (session mode) tercih edilir.
DATABASE_URL=postgresql://postgres.<proje-ref>:<PAROLA>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://<proje-ref>.supabase.co
SUPABASE_ANON_KEY=
# Servis anahtari yalnizca worker'da kullanilir, siteye ASLA konmaz.
SUPABASE_SERVICE_ROLE_KEY=

# --- KAP cekici ---
# WAF bagliliginda ucu de zorunlu (bkz. spec Adim 0):
# oturum isitmasi + Referer + durust User-Agent
KAP_USER_AGENT=kap-radar/0.1 (+iletisim: ornek@ornek.com)
KAP_ISTEK_ARALIGI_MS=500
KAP_MAKS_YENIDEN_DENEME=5

# --- Gemini (ilk kez Adim 12'de kullanilir) ---
GEMINI_API_KEY=
GEMINI_KATMAN1_MODEL=gemini-3.1-flash-lite
GEMINI_KATMAN2_MODEL=gemini-3.8-flash

# --- X / Twitter botu (Adim 11+) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
